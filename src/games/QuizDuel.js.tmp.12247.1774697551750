import React, { useState, useEffect, useCallback, useMemo, useRef } from 'react';
import {
  View,
  Text,
  TouchableOpacity,
  ScrollView,
  StyleSheet,
  Animated,
  Dimensions,
  Image,
} from 'react-native';
import { IMAGES, shuffleArray } from '../data/questions';

const { width: SCREEN_WIDTH, height: SCREEN_HEIGHT } = Dimensions.get('window');

const COLORS = {
  red: '#C0392B',
  gold: '#F39C12',
  blue: '#2980B9',
  green: '#27AE60',
  light: '#FFF9F5',
  white: '#FFFFFF',
  dark: '#2C3E50',
  gray: '#95A5A6',
};

const QUESTIONS_PER_DUEL = 10;

const DIFFICULTY = {
  easy:   { label: 'Leicht',  rate: 0.50, emoji: '🟢' },
  medium: { label: 'Mittel',  rate: 0.70, emoji: '🟡' },
  hard:   { label: 'Schwer',  rate: 0.90, emoji: '🔴' },
};

function prepareQuestions(questions) {
  const eligible = questions.filter(
    (q) => (q.type === 'multiple_choice' || q.type === 'image_choice') &&
           q.options && q.options.length === 4,
  );
  return shuffleArray(eligible).slice(0, QUESTIONS_PER_DUEL);
}

// --- Confetti Particle ---
function ConfettiParticle({ delay, color }) {
  const translateY = useRef(new Animated.Value(-20)).current;
  const translateX = useRef(new Animated.Value(0)).current;
  const opacity = useRef(new Animated.Value(1)).current;
  const rotate = useRef(new Animated.Value(0)).current;
  const startX = useMemo(() => Math.random() * SCREEN_WIDTH, []);
  const size = useMemo(() => 6 + Math.random() * 8, []);

  useEffect(() => {
    const drift = (Math.random() - 0.5) * 120;
    const duration = 2000 + Math.random() * 1500;
    Animated.sequence([
      Animated.delay(delay),
      Animated.parallel([
        Animated.timing(translateY, { toValue: SCREEN_HEIGHT + 40, duration, useNativeDriver: true }),
        Animated.timing(translateX, { toValue: drift, duration, useNativeDriver: true }),
        Animated.timing(opacity, { toValue: 0, duration: duration * 0.8, delay: duration * 0.2, useNativeDriver: true }),
        Animated.timing(rotate, { toValue: 4 + Math.random() * 4, duration, useNativeDriver: true }),
      ]),
    ]).start();
  }, [delay, translateY, translateX, opacity, rotate]);

  const spin = rotate.interpolate({ inputRange: [0, 1], outputRange: ['0deg', '360deg'] });

  return (
    <Animated.View
      style={{
        position: 'absolute',
        left: startX,
        top: -10,
        width: size,
        height: size * 1.4,
        borderRadius: 2,
        backgroundColor: color,
        opacity,
        transform: [{ translateY }, { translateX }, { rotate: spin }],
      }}
    />
  );
}

// --- Confetti Overlay ---
function ConfettiOverlay() {
  const confettiColors = [COLORS.gold, COLORS.green, COLORS.blue, COLORS.red, '#E74C3C', '#9B59B6', '#1ABC9C', '#F1C40F'];
  const particles = useMemo(() =>
    Array.from({ length: 40 }, (_, i) => ({
      id: i,
      delay: Math.random() * 800,
      color: confettiColors[i % confettiColors.length],
    })), []);

  return (
    <View style={StyleSheet.absoluteFill} pointerEvents="none">
      {particles.map((p) => (
        <ConfettiParticle key={p.id} delay={p.delay} color={p.color} />
      ))}
    </View>
  );
}

// --- Avatar Component ---
function Avatar({ emoji, name, score, total, isRight, flashColor, side }) {
  const flashAnim = useRef(new Animated.Value(0)).current;

  useEffect(() => {
    if (flashColor) {
      flashAnim.setValue(1);
      Animated.timing(flashAnim, { toValue: 0, duration: 1200, useNativeDriver: false }).start();
    }
  }, [flashColor, flashAnim]);

  const bgColor = flashAnim.interpolate({
    inputRange: [0, 1],
    outputRange: ['rgba(255,255,255,0)', flashColor === 'green' ? 'rgba(39,174,96,0.35)' : 'rgba(192,57,43,0.35)'],
  });

  return (
    <Animated.View style={[styles.avatarContainer, side === 'right' && styles.avatarRight, { backgroundColor: bgColor }]}>
      <View style={styles.avatarCircle}>
        <Text style={styles.avatarEmoji}>{emoji}</Text>
      </View>
      <Text style={styles.avatarName} numberOfLines={1}>{name}</Text>
      <Text style={styles.avatarScore}>{score} / {total}</Text>
    </Animated.View>
  );
}

// --- Difficulty Selector ---
function DifficultySelector({ onSelect }) {
  const fadeAnim = useRef(new Animated.Value(0)).current;
  const slideAnim = useRef(new Animated.Value(30)).current;

  useEffect(() => {
    Animated.parallel([
      Animated.timing(fadeAnim, { toValue: 1, duration: 500, useNativeDriver: true }),
      Animated.timing(slideAnim, { toValue: 0, duration: 500, useNativeDriver: true }),
    ]).start();
  }, [fadeAnim, slideAnim]);

  return (
    <Animated.View style={[styles.difficultyScreen, { opacity: fadeAnim, transform: [{ translateY: slideAnim }] }]}>
      <Text style={styles.diffTitle}>Quiz-Duell</Text>
      <Text style={styles.diffSubtitle}>gegen Professor Wien 🎓</Text>
      <View style={styles.diffOpponentCard}>
        <Text style={styles.diffOpponentEmoji}>🎓</Text>
        <Text style={styles.diffOpponentName}>Professor Wien</Text>
        <Text style={styles.diffOpponentDesc}>Dein Gegner kennt Wien wie seine Westentasche!</Text>
      </View>
      <Text style={styles.diffLabel}>Schwierigkeitsgrad:</Text>
      {Object.entries(DIFFICULTY).map(([key, val]) => (
        <TouchableOpacity key={key} style={styles.diffButton} activeOpacity={0.7} onPress={() => onSelect(key)}>
          <Text style={styles.diffButtonEmoji}>{val.emoji}</Text>
          <View style={styles.diffButtonTextWrap}>
            <Text style={styles.diffButtonLabel}>{val.label}</Text>
            <Text style={styles.diffButtonRate}>KI-Trefferquote: {Math.round(val.rate * 100)}%</Text>
          </View>
        </TouchableOpacity>
      ))}
    </Animated.View>
  );
}

// --- Main Component ---
export default function QuizDuel({ questions, onBack }) {
  const [phase, setPhase] = useState('difficulty'); // difficulty, playing, result, intermission, opponentTurn
  const [difficulty, setDifficulty] = useState(null);
  const [duelQuestions, setDuelQuestions] = useState([]);
  const [currentIndex, setCurrentIndex] = useState(0);
  const [playerScore, setPlayerScore] = useState(0);
  const [opponentScore, setOpponentScore] = useState(0);
  const [playerAnswer, setPlayerAnswer] = useState(null);
  const [opponentAnswer, setOpponentAnswer] = useState(null);
  const [playerFlash, setPlayerFlash] = useState(null);
  const [opponentFlash, setOpponentFlash] = useState(null);
  const [showExplanation, setShowExplanation] = useState(false);
  const [opponentChoices, setOpponentChoices] = useState([]);
  const [shuffledOptions, setShuffledOptions] = useState([]);
  const [correctMapped, setCorrectMapped] = useState(0);

  const fadeAnim = useRef(new Animated.Value(1)).current;
  const slideAnim = useRef(new Animated.Value(0)).current;
  const resultFade = useRef(new Animated.Value(0)).current;
  const resultScale = useRef(new Animated.Value(0.7)).current;
  const intermissionFade = useRef(new Animated.Value(0)).current;
  const dramaticDots = useRef(new Animated.Value(0)).current;

  const currentQ = duelQuestions[currentIndex];

  // Pre-compute opponent answers for all questions
  const generateOpponentChoices = useCallback((qs, diff) => {
    const rate = DIFFICULTY[diff].rate;
    return qs.map((q) => Math.random() < rate);
  }, []);

  const startDuel = useCallback((diff) => {
    const qs = prepareQuestions(questions);
    setDifficulty(diff);
    setDuelQuestions(qs);
    setCurrentIndex(0);
    setPlayerScore(0);
    setOpponentScore(0);
    setPlayerAnswer(null);
    setOpponentAnswer(null);
    setPlayerFlash(null);
    setOpponentFlash(null);
    setShowExplanation(false);
    const choices = generateOpponentChoices(qs, diff);
    setOpponentChoices(choices);

    // Shuffle options for first question
    const firstQ = qs[0];
    if (firstQ) {
      const indices = [0, 1, 2, 3];
      const shuffled = shuffleArray(indices);
      setShuffledOptions(shuffled.map(i => firstQ.options[i]));
      setCorrectMapped(shuffled.indexOf(firstQ.correct));
    }

    setPhase('playing');
    fadeAnim.setValue(0);
    slideAnim.setValue(40);
    Animated.parallel([
      Animated.timing(fadeAnim, { toValue: 1, duration: 400, useNativeDriver: true }),
      Animated.timing(slideAnim, { toValue: 0, duration: 400, useNativeDriver: true }),
    ]).start();
  }, [questions, generateOpponentChoices, fadeAnim, slideAnim]);

  const setupQuestionAnim = useCallback((index) => {
    const q = duelQuestions[index];
    if (q) {
      const indices = [0, 1, 2, 3];
      const shuffled = shuffleArray(indices);
      setShuffledOptions(shuffled.map(i => q.options[i]));
      setCorrectMapped(shuffled.indexOf(q.correct));
    }
    fadeAnim.setValue(0);
    slideAnim.setValue(40);
    Animated.parallel([
      Animated.timing(fadeAnim, { toValue: 1, duration: 350, useNativeDriver: true }),
      Animated.timing(slideAnim, { toValue: 0, duration: 350, useNativeDriver: true }),
    ]).start();
  }, [duelQuestions, fadeAnim, slideAnim]);

  const handleAnswer = useCallback((selectedIndex) => {
    if (playerAnswer !== null) return;

    const playerCorrect = selectedIndex === correctMapped;
    const oppCorrect = opponentChoices[currentIndex];

    setPlayerAnswer(selectedIndex);
    setPlayerFlash(playerCorrect ? 'green' : 'red');
    setShowExplanation(true);

    if (playerCorrect) setPlayerScore((s) => s + 1);

    // Show opponent result after short delay
    const timer = setTimeout(() => {
      setOpponentAnswer(oppCorrect);
      setOpponentFlash(oppCorrect ? 'green' : 'red');
      if (oppCorrect) setOpponentScore((s) => s + 1);
    }, 600);

    return () => clearTimeout(timer);
  }, [playerAnswer, correctMapped, opponentChoices, currentIndex]);

  const proceedToNext = useCallback(() => {
    const nextIndex = currentIndex + 1;

    if (nextIndex >= duelQuestions.length) {
      // Final result
      setPhase('result');
      resultFade.setValue(0);
      resultScale.setValue(0.7);
      Animated.parallel([
        Animated.timing(resultFade, { toValue: 1, duration: 500, useNativeDriver: true }),
        Animated.spring(resultScale, { toValue: 1, friction: 5, useNativeDriver: true }),
      ]).start();
      return;
    }

    // Intermission screen
    const isLastQuestion = nextIndex === duelQuestions.length - 1;
    setPhase('intermission');
    intermissionFade.setValue(0);
    Animated.timing(intermissionFade, { toValue: 1, duration: 300, useNativeDriver: true }).start();

    const delay = isLastQuestion ? 2500 : 1500;

    if (isLastQuestion) {
      dramaticDots.setValue(0);
      Animated.timing(dramaticDots, { toValue: 3, duration: 2000, useNativeDriver: false }).start();
    }

    const timer = setTimeout(() => {
      setCurrentIndex(nextIndex);
      setPlayerAnswer(null);
      setOpponentAnswer(null);
      setPlayerFlash(null);
      setOpponentFlash(null);
      setShowExplanation(false);
      setPhase('playing');
      setupQuestionAnim(nextIndex);
    }, delay);

    return () => clearTimeout(timer);
  }, [currentIndex, duelQuestions, resultFade, resultScale, intermissionFade, dramaticDots, setupQuestionAnim]);

  const restartDuel = useCallback(() => {
    setPhase('difficulty');
    setDifficulty(null);
  }, []);

  // Get option style based on answer state
  const getOptionStyle = useCallback((index) => {
    if (playerAnswer === null) return styles.optionDefault;
    if (index === correctMapped) return styles.optionCorrect;
    if (index === playerAnswer && playerAnswer !== correctMapped) return styles.optionWrong;
    return styles.optionDimmed;
  }, [playerAnswer, correctMapped]);

  const getOptionTextStyle = useCallback((index) => {
    if (playerAnswer === null) return styles.optionTextDefault;
    if (index === correctMapped) return styles.optionTextCorrect;
    if (index === playerAnswer && playerAnswer !== correctMapped) return styles.optionTextWrong;
    return styles.optionTextDimmed;
  }, [playerAnswer, correctMapped]);

  // --- Difficulty screen ---
  if (phase === 'difficulty') {
    return (
      <View style={styles.container}>
        <TouchableOpacity style={styles.backButton} onPress={onBack} activeOpacity={0.7}>
          <Text style={styles.backText}>← Zurück</Text>
        </TouchableOpacity>
        <ScrollView contentContainerStyle={styles.scrollContent} showsVerticalScrollIndicator={false}>
          <DifficultySelector onSelect={startDuel} />
        </ScrollView>
      </View>
    );
  }

  // --- Intermission screen ---
  if (phase === 'intermission') {
    const nextIndex = currentIndex + 1;
    const isLast = nextIndex === duelQuestions.length - 1;
    const playerLeading = playerScore > opponentScore;
    const tied = playerScore === opponentScore;

    return (
      <View style={styles.container}>
        <Animated.View style={[styles.intermissionWrap, { opacity: intermissionFade }]}>
          <Text style={styles.intermissionTitle}>Zwischenstand</Text>
          <View style={styles.intermissionScores}>
            <View style={styles.intermissionPlayer}>
              <Text style={styles.intermissionEmoji}>🧑‍🎓</Text>
              <Text style={styles.intermissionName}>Du</Text>
              <Text style={[styles.intermissionScoreNum, playerLeading && styles.intermissionLeading]}>
                {playerScore}
              </Text>
            </View>
            <View style={styles.intermissionDivider}>
              <Text style={styles.intermissionVs}>VS</Text>
              <Text style={styles.intermissionQCount}>
                Frage {nextIndex + 1} / {duelQuestions.length}
              </Text>
            </View>
            <View style={styles.intermissionPlayer}>
              <Text style={styles.intermissionEmoji}>🎓</Text>
              <Text style={styles.intermissionName}>Prof. Wien</Text>
              <Text style={[styles.intermissionScoreNum, !playerLeading && !tied && styles.intermissionLeading]}>
                {opponentScore}
              </Text>
            </View>
          </View>

          {isLast && (
            <View style={styles.dramaticWrap}>
              <Text style={styles.dramaticText}>
                {tied ? 'Gleichstand! Letzte Frage entscheidet!' :
                 playerLeading ? 'Du führst! Noch eine Frage!' :
                 'Professor Wien führt! Letzte Chance!'}
              </Text>
              <Text style={styles.dramaticDots}>...</Text>
            </View>
          )}

          {!isLast && (
            <Text style={styles.intermissionHint}>
              {tied ? 'Gleichstand - alles ist offen!' :
               playerLeading ? 'Weiter so! 💪' : 'Aufholen! Du schaffst das!'}
            </Text>
          )}
        </Animated.View>
      </View>
    );
  }

  // --- Result screen ---
  if (phase === 'result') {
    const playerWon = playerScore > opponentScore;
    const tied = playerScore === opponentScore;
    const diff = DIFFICULTY[difficulty];

    return (
      <View style={styles.container}>
        {playerWon && <ConfettiOverlay />}
        <ScrollView contentContainerStyle={styles.scrollContent} showsVerticalScrollIndicator={false}>
          <Animated.View style={[styles.resultWrap, { opacity: resultFade, transform: [{ scale: resultScale }] }]}>
            <Text style={styles.resultIcon}>
              {playerWon ? '🏆' : tied ? '🤝' : '😔'}
            </Text>
            <Text style={styles.resultTitle}>
              {playerWon ? 'Du hast gewonnen!' : tied ? 'Unentschieden!' : 'Professor Wien gewinnt!'}
            </Text>
            <Text style={styles.resultSubtitle}>
              {playerWon ? 'Gratulation! Du hast Professor Wien geschlagen!' :
               tied ? 'Ein knappes Duell - beide gleich gut!' :
               'Professor Wien war diesmal stärker. Nächstes Mal!'}
            </Text>

            <View style={styles.resultScoreCard}>
              <View style={styles.resultScoreRow}>
                <Text style={styles.resultScoreEmoji}>🧑‍🎓</Text>
                <Text style={styles.resultScoreLabel}>Du</Text>
                <Text style={[styles.resultScoreVal, playerWon && styles.resultScoreWinner]}>
                  {playerScore}
                </Text>
              </View>
              <View style={styles.resultScoreDivider} />
              <View style={styles.resultScoreRow}>
                <Text style={styles.resultScoreEmoji}>🎓</Text>
                <Text style={styles.resultScoreLabel}>Prof. Wien</Text>
                <Text style={[styles.resultScoreVal, !playerWon && !tied && styles.resultScoreWinner]}>
                  {opponentScore}
                </Text>
              </View>
            </View>

            <Text style={styles.resultDiffInfo}>
              Schwierigkeit: {diff.emoji} {diff.label} ({Math.round(diff.rate * 100)}%)
            </Text>

            <TouchableOpacity style={styles.revancheButton} activeOpacity={0.7} onPress={restartDuel}>
              <Text style={styles.revancheText}>🔄 Revanche!</Text>
            </TouchableOpacity>

            <TouchableOpacity style={styles.backButtonResult} activeOpacity={0.7} onPress={onBack}>
              <Text style={styles.backButtonResultText}>← Zurück zur Auswahl</Text>
            </TouchableOpacity>
          </Animated.View>
        </ScrollView>
      </View>
    );
  }

  // --- Playing screen ---
  if (!currentQ) return null;

  const questionNumber = currentIndex + 1;
  const totalQuestions = duelQuestions.length;

  return (
    <View style={styles.container}>
      {/* Back button */}
      <TouchableOpacity style={styles.backButton} onPress={onBack} activeOpacity={0.7}>
        <Text style={styles.backText}>← Zurück</Text>
      </TouchableOpacity>

      {/* Duel Header */}
      <View style={styles.duelHeader}>
        <Avatar
          emoji="🧑‍🎓"
          name="Du"
          score={playerScore}
          total={totalQuestions}
          flashColor={playerFlash}
          side="left"
        />
        <View style={styles.vsContainer}>
          <Text style={styles.vsText}>VS</Text>
          <Text style={styles.questionCounter}>{questionNumber}/{totalQuestions}</Text>
        </View>
        <Avatar
          emoji="🎓"
          name="Prof. Wien"
          score={opponentScore}
          total={totalQuestions}
          flashColor={opponentFlash}
          side="right"
        />
      </View>

      {/* Progress Bar */}
      <View style={styles.progressBar}>
        <View style={[styles.progressFill, { width: `${(questionNumber / totalQuestions) * 100}%` }]} />
      </View>

      {/* Question Area */}
      <ScrollView contentContainerStyle={styles.questionScroll} showsVerticalScrollIndicator={false}>
        <Animated.View style={{ opacity: fadeAnim, transform: [{ translateY: slideAnim }] }}>
          {/* Topic */}
          <Text style={styles.topicLabel}>{currentQ.topic}</Text>

          {/* Image if any */}
          {currentQ.image && IMAGES[currentQ.image] && (
            <View style={styles.imageWrap}>
              <Image
                source={IMAGES[currentQ.image]}
                style={styles.questionImage}
                resizeMode="contain"
              />
              {currentQ.imageHint && (
                <Text style={styles.imageHint}>{currentQ.imageHint}</Text>
              )}
            </View>
          )}

          {/* Question text */}
          <Text style={styles.questionText}>{currentQ.question}</Text>

          {/* Options */}
          <View style={styles.optionsContainer}>
            {shuffledOptions.map((option, index) => (
              <TouchableOpacity
                key={index}
                style={[styles.optionButton, getOptionStyle(index)]}
                activeOpacity={0.7}
                onPress={() => handleAnswer(index)}
                disabled={playerAnswer !== null}
              >
                <Text style={[styles.optionLabel, { marginRight: 8 }]}>
                  {String.fromCharCode(65 + index)}
                </Text>
                <Text style={[styles.optionText, getOptionTextStyle(index)]} numberOfLines={3}>
                  {option}
                </Text>
              </TouchableOpacity>
            ))}
          </View>

          {/* Opponent result */}
          {opponentAnswer !== null && (
            <View style={[styles.opponentResultBanner, opponentAnswer ? styles.opponentCorrectBanner : styles.opponentWrongBanner]}>
              <Text style={styles.opponentResultText}>
                🎓 Professor Wien hat {opponentAnswer ? 'richtig' : 'falsch'} geantwortet!
              </Text>
            </View>
          )}

          {/* Explanation */}
          {showExplanation && currentQ.explanation && (
            <View style={styles.explanationBox}>
              <Text style={styles.explanationText}>{currentQ.explanation}</Text>
            </View>
          )}

          {/* Next button */}
          {playerAnswer !== null && opponentAnswer !== null && (
            <TouchableOpacity style={styles.nextButton} activeOpacity={0.7} onPress={proceedToNext}>
              <Text style={styles.nextButtonText}>
                {currentIndex < duelQuestions.length - 1 ? 'Nächste Frage →' : 'Ergebnis ansehen →'}
              </Text>
            </TouchableOpacity>
          )}
        </Animated.View>
      </ScrollView>
    </View>
  );
}

