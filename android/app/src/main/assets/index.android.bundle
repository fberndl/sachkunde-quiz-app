',21:'#2980B9',22:'#C0392B',23:'#C0392B'},c=['Innere Stadt','Leopoldstadt','Landstra\xdfe','Wieden','Margareten','Mariahilf','Neubau','Josefstadt','Alsergrund','Favoriten','Simmering','Meidling','Hietzing','Penzing','Rudolfsheim-F\xfcnfhaus','Ottakring','Hernals','W\xe4hring','D\xf6bling','Brigittenau','Floridsdorf','Donaustadt','Liesing'],u=[{text:'Einmal (1. Bezirk) lebte in der inneren Stadt ({Innere Stadt}) ein Herr namens Leopold ({Leopoldstadt}) der Zweite (2. Bezirk).',blanks:[{district:'Innere Stadt',number:1},{district:'Leopoldstadt',number:2}]},{text:'Jeden 3. Tag (3. Bezirk) wanderte er \xfcber die {Landstra\xdfe} vier Stunden lang (4. Bezirk) nach {Wieden}.',blanks:[{district:'Landstra\xdfe',number:3},{district:'Wieden',number:4}]},{text:'Dort traf er um 5 Uhr (5. Bezirk) bei {Margareten}, seiner Freundin ein. Sie musste bis 6 Uhr (6. Bezirk) ihrer Schwester Maria helfen ({Mariahilf}), doch danach konnten die beiden Verlobten endlich ihre Wohnung im 7. Stock (7. Bezirk) eines {Neubau}s besichtigen, wo sie nach ihrer Hochzeit wohnen wollten.',blanks:[{district:'Margareten',number:5},{district:'Mariahilf',number:6},{district:'Neubau',number:7}]},{text:'Vor acht Tagen (8. Bezirk) hatten sie die Wohnung von einem Herrn Josef aus der Stadt ({Josefstadt}) gekauft. Sie lag im 9. Bezirk, im {Alsergrund}. Diese geh\xf6rte zu den zehn (10. Bezirk) {Favoriten} unter den Wohnungen, die Leopold und Margarete besichtigt hatten.',blanks:[{district:'Josefstadt',number:8},{district:'Alsergrund',number:9},{district:'Favoriten',number:10}]},{text:'Als endlich Hochzeit gefeiert wurde, schenkte Leopold seiner Braut elf (11. Bezirk) schimmernde Ringe ({Simmering}). Unter den vielen G\xe4sten waren auch seine Freunde aus China mit ihren 3 S\xf6hnen: dem 12-j\xe4hrigen Mei Ling (12. Bezirk {Meidling}), dem 13-j\xe4hrigen Hi Tsing (13. Bezirk {Hietzing}) und dem 14-j\xe4hrigen Pen Tsing (14. Bezirk {Penzing}). Auch Rudolf Heim, der 5 H\xe4user besa\xdf ({Rudolfsheim-F\xfcnfhaus}), war unter den G\xe4sten (15. Bezirk).',blanks:[{district:'Simmering',number:11},{district:'Meidling',number:12},{district:'Hietzing',number:13},{district:'Penzing',number:14},{district:'Rudolfsheim-F\xfcnfhaus',number:15}]},{text:'Um 16 Uhr (16. Bezirk) trafen die G\xe4ste in der {Ottakring}er Brauerei zur Festtafel ein. Den 17 Feiernden (17. Bezirk) servierte Herr Nals ({Hernals}) die k\xf6stlichsten Speisen.',blanks:[{district:'Ottakring',number:16},{district:'Hernals',number:17}]},{text:'Das Brautpaar hatte 18 Monate (18. Bezirk) gespart, um genug {W\xe4hring} f\xfcr ihr Hochzeitsfest auf der Bank zu haben.',blanks:[{district:'W\xe4hring',number:18}]},{text:'Leopold und Margarete waren schon lange ein Paar - seit sie einander mit 19 Jahren (19. Bezirk) in {D\xf6bling} getroffen hatten. Ihre gemeinsamen Freunde, die 20-j\xe4hrige (20. Bezirk) Brigitte aus der Au ({Brigittenau}) und der 21-j\xe4hrige (21. Bezirk) Flori aus dem Dorf ({Floridsdorf}) hatten sie miteinander bekannt gemacht.',blanks:[{district:'D\xf6bling',number:19},{district:'Brigittenau',number:20},{district:'Floridsdorf',number:21}]},{text:'Sie verliebten sich schon nach 22 Tagen (22. Bezirk) ineinander, als sie mit einem Schiff auf der Donau aus der Stadt ({Donaustadt}) schipperten.',blanks:[{district:'Donaustadt',number:22}]},{text:'Nun lebten sie gl\xfccklich und zufrieden zusammen und betrieben 23 Jahre lang (23. Bezirk) eine gemeinsame Leasing-Firma ({Liesing}). Und wenn sie nicht gestorben sind, dann wandern sie noch heute durch alle Bezirke Wiens!',blanks:[{district:'Liesing',number:23}]}],h=8;function f(e){for(var t=(0,n.default)(e),r=t.length-1;r>0;r--){var i=Math.floor(Math.random()*(r+1)),o=[t[i],t[r]];t[r]=o[0],t[i]=o[1]}return t}function x(e){for(var t=[e];t.length<4;){var r=Math.floor(23*Math.random());t.includes(r)||t.push(r)}return f(t)}function y(e){for(var t=[],r=e,n=0;r.length>0;){var i=r.indexOf('{');if(-1===i){t.push((0,a.jsx)(o.Text,{style:z.storyText,children:r},n++));break